# EditorConfig is awesome: https://EditorConfig.org
# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Python files
[*.py]
indent_style = space
indent_size = 4
max_line_length = 79

# ReStructuredText files
[*.rst]
indent_style = space
indent_size = 3
max_line_length = 79

# YAML files
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Jinja2 templates
[*.{j2,jinja2}]
indent_style = space
indent_size = 2

# Shell scripts
[*.{sh,bash}]
indent_style = space
indent_size = 4

# Dockerfile
[Dockerfile*]
indent_style = space
indent_size = 4

# Makefile (must use tabs)
[Makefile]
indent_style = tab
indent_size = 4

# INI files
[*.{ini,conf,cfg}]
indent_style = space
indent_size = 4

# JSON files
[*.json]
indent_style = space
indent_size = 2

# Markdown files
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# TOML files
[*.toml]
indent_style = space
indent_size = 4

# Git commit messages
[COMMIT_EDITMSG]
max_line_length = 72

# Documentation
[*.{tex,bib}]
indent_style = space
indent_size = 2
